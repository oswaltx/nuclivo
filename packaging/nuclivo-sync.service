[Unit]
Description=Nuclivo – Live-Sync mit Proton Drive
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/nuclivo/nuclivo-sync.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
